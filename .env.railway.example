# Railway Environment Variables (set in Railway dashboard)
# ─── Database (auto-provided by Railway PostgreSQL plugin) ───────────
DATABASE_URL=${{Postgres.DATABASE_URL}}  # Railway provides this automatically

# ─── API ───────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=${{PORT}}                      # Railway provides PORT automatically
SESSION_SECRET=GENERATE_A_RANDOM_32_CHAR_STRING

# ─── AI: DeepSeek (recommended for Railway) ───────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# ─── Frontend ─────────────────────────────────────────────────────────
VITE_API_URL=https://your-api-service.railway.app  # API service URL from Railway
