# .env for DeepSeek deployment (no Ollama needed)
POSTGRES_USER=ideaportal
POSTGRES_DB=ideaportal
POSTGRES_PASSWORD=CHANGE_ME

NODE_ENV=production
API_PORT=3000
SESSION_SECRET=CHANGE_ME_MIN_32_CHARS

# DeepSeek AI
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat

# Ollama not needed — leave empty or remove
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=
